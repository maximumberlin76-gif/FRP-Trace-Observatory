              raise SystemExit("Installed M31 registry test verification failed")
          print(f"test_bytes={len(source)}")
          print(f"test_sha256={observed_source_sha256}")
          PY

      - name: Qualify exact M31 registry tests and complete Observatory
        working-directory: observatory
        shell: bash
        env:
          FRP_M31_UPSTREAM_ROOT: ../upstream
          FRP_M30_ARCHIVE_PATH: ../upstream/artifacts/m30/packages/frp-v3.2.0-m30-archival-release.tar.gz
          PYTHONDONTWRITEBYTECODE: "1"
        run: |
          set -euo pipefail
          export PYTHONPYCACHEPREFIX="$RUNNER_TEMP/frp-observatory-m13-pycache"

          python -m compileall -q \
            artifact_auditor \
            parsers \
            schemas \
            tests \
            trace_explorer \
            transition_visualizer

          python -m unittest \
            tests.test_m31_published_registry \
            -v 2>&1 \
            | tee "$RUNNER_TEMP/frp-observatory-m13-dedicated-tests.txt"

          grep -F "Ran 21 tests" \
            "$RUNNER_TEMP/frp-observatory-m13-dedicated-tests.txt"
          grep -Fx "OK" \
            "$RUNNER_TEMP/frp-observatory-m13-dedicated-tests.txt"

          python -m schemas.m31_published_registry \
            --upstream-root "$FRP_M31_UPSTREAM_ROOT" \
            | tee "$RUNNER_TEMP/frp-observatory-m13-registry.txt"

          grep -Fx \
            "FRP Observatory M31 published document registry: PASS" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "published_documents=4" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "mode_routes=6" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "artifact_auditor_routes=4" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "ternary_transition_visualizer_routes=1" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "trace_explorer_routes=1" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "schema_aliases=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "metric_normalization=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "source_execution=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "semantic_reimplementation=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "source_mutation=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"
          grep -Fx "downstream_writeback=forbidden" \
            "$RUNNER_TEMP/frp-observatory-m13-registry.txt"

          python -m unittest discover \
            -s tests \
            -p 'test_*.py' \
            -v 2>&1 \
            | tee "$RUNNER_TEMP/frp-observatory-m13-full-tests.txt"

          grep -F "Ran 489 tests" \
            "$RUNNER_TEMP/frp-observatory-m13-full-tests.txt"
          grep -Fx "OK" \
            "$RUNNER_TEMP/frp-observatory-m13-full-tests.txt"

          git -C ../upstream diff --exit-code
          if [[ -n "$(git -C ../upstream status --porcelain)" ]]; then
            echo "The read-only FRP checkout was modified."
            git -C ../upstream status --short
            exit 1
          fi

          python - <<'PY'
          import subprocess

          expected = "?? tests/test_m31_published_registry.py"
          status = subprocess.run(
              [
                  "git",
                  "status",
                  "--porcelain=v1",
                  "--untracked-files=all",
              ],
              check=True,
              capture_output=True,
              text=True,
          ).stdout.splitlines()
          if status not in ([], [expected]):
              raise SystemExit(
                  "Unexpected Observatory changes before publication: "
                  f"{status!r}"
              )
          print("Read-only upstream and one-test-file boundary: PASS")
          PY

      - name: Commit and publish only the M31 registry tests
        working-directory: observatory
        shell: bash
        env:
          TEST_SOURCE_SHA256: cd8e89b4682a794dd6543ba779f5758e76e4b344cbbc7c61341bd6caa2694970
        run: |
          set -euo pipefail
          target="tests/test_m31_published_registry.py"

          python - <<'PY'
          import hashlib
          import os
          import subprocess
          from pathlib import Path

          target = Path("tests/test_m31_published_registry.py")
          if target.is_symlink() or not target.is_file():
              raise SystemExit("Exact M31 registry tests are missing")
          observed = hashlib.sha256(target.read_bytes()).hexdigest()
          if observed != os.environ["TEST_SOURCE_SHA256"]:
              raise SystemExit(f"M31 registry test digest mismatch: {observed}")

          expected_untracked = f"?? {target.as_posix()}"
          status = subprocess.run(
              [
                  "git",
                  "status",
                  "--porcelain=v1",
                  "--untracked-files=all",
              ],
              check=True,
              capture_output=True,
              text=True,
          ).stdout.splitlines()
          if status not in ([], [expected_untracked]):
              raise SystemExit(
                  "Refusing publication with unrelated changes: "
                  f"{status!r}"
              )
          PY

          git add -- "$target"

          staged="$(git diff --cached --name-only)"
          if [[ -z "$staged" ]]; then
            echo "Exact M31 registry tests are already published; no commit needed."
            exit 0
          fi
          if [[ "$staged" != "$target" ]]; then
            echo "Unexpected staged publication boundary:"
            git diff --cached --name-only
            exit 1
          fi
          if [[ -n "$(git diff --name-only)" ]]; then
            echo "Unexpected unstaged tracked changes:"
            git diff --name-only
            exit 1
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit -m "Add M31 published registry tests"
          git push origin HEAD:main

